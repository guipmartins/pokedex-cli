# Copie este arquivo para ".env" e preencha UMA das chaves abaixo.
# O .env está no .gitignore, então sua chave não vai pro GitHub.

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ou OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

# Opcional: forçar provedor (anthropic | openai) e modelo
# AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-5-5
